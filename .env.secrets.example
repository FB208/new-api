# new-api GitHub Actions Secrets 示例
# 用法：
# 1. 复制本文件为 .env.secrets
# 2. 填入真实值
# 3. 在仓库根目录执行：.\Scripts\sync-secrets.ps1
# 4. 脚本会把下面这些键同步到当前 GitHub 仓库的 Actions Secrets

# ========================================
# 部署结果通知
# ========================================
# GitHub Actions 部署结果通知邮箱账号
GMAIL_USERNAME=your_email@gmail.com

# 上面邮箱对应的应用专用密码
GMAIL_PASSWORD=your_app_password

# 接收部署通知的目标邮箱
GMAIL_TO=notify_target@example.com

# ========================================
# 镜像仓库
# ========================================
# 容器镜像仓库地址，例如 docker.example.com
REGISTRY=docker.example.com

# 镜像仓库用户名
REGISTRY_USERNAME=your_registry_username

# 镜像仓库密码
REGISTRY_PASSWORD=your_registry_password

# 镜像完整仓库名，例如 docker.example.com/new-api
REGISTRY_REPO=docker.example.com/new-api

# ========================================
# 部署服务器
# ========================================
# 部署服务器地址
SSH_HOST=your.server.ip.or.domain

# 部署服务器 SSH 端口
SSH_PORT=22

# 部署服务器 SSH 用户名
SSH_USER=deploy_user

# 部署服务器 SSH 密码
SSH_PASSWORD=your_ssh_password

# 服务器上的部署目录，该目录内应包含 docker-compose.yml（由 deploy/ 复制过去）
# 注意与应用数据目录 /home/DockerVolumes/new-api 分开，避免污染应用自身的 .env
DEPLOY_DIR=/home/DockerCompose/new-api
